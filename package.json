{
  "name": "dsh-academic-lab",
  "version": "0.1.4",
  "displayName": "DSH Academic Data Lab",
  "description": "DSH 学术数据工作台：数据审计、统计推断（效应量/置信区间/前提检查/多重比较校正）与出版级出图，每次分析写入可复现运行台账。",
  "type": "module",
  "main": "./dsh/index.js",
  "exports": {
    ".": "./dsh/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "dsh/index.js",
    "lib/client.js",
    "py/lab_common.py",
    "py/lab_profile.py",
    "py/lab_stats.py",
    "py/lab_figure.py",
    "py/lab_runner.py",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "license": "MIT",
  "author": "DSH Academic Data Lab",
  "keywords": [
    "dsh-plugin",
    "workbench",
    "data-science",
    "statistics",
    "visualization",
    "数据科学",
    "数据可视化"
  ],
  "scripts": {
    "verify": "node scripts/verify.mjs",
    "check-package": "node scripts/check-package.mjs",
    "pack:check": "node scripts/verify.mjs && node scripts/check-package.mjs"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-tools": "*",
    "@deepseek-ai/schemastery": "*"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "dsh-desktop-workbenches",
        "@deepseek-ai/dsh-client-locale"
      ]
    }
  }
}
